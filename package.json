{
  "name": "admin-ui",
  "version": "0.19.3",
  "type": "module",
  "description": "Admin UI component library — design tokens, primitives, and navigation components",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles/index.css",
    "./mixins": "./src/styles/design-system.css",
    "./component-mixins": "./src/styles/mixins.css",
    "./themes": "./src/styles/themes.css"
  },
  "files": [
    "dist",
    "src/styles/design-system.css",
    "src/styles/mixins.css",
    "src/styles/themes.css",
    "LLM_GUIDANCE.md"
  ],
  "scripts": {
    "dev": "vite --config vite.catalog.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:catalog": "vite build --config vite.catalog.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.38",
    "postcss-mixins": "^10.0.0",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.400.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
